# MarginWatch — copy to .env for local runs (never commit .env).
# In prod (Render) these are set as environment variables; see render.yaml.

# Neon PostgreSQL connection string (scheme swapped to jdbc:postgresql://)
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-xxx.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=

# Generate a long random value in prod (Render generateValue does this)
JWT_SECRET=local-dev-only-secret-0123456789abcdef0123456789abcdef

# Seeded real admin account password (demo accounts use public Demo@... passwords)
ADMIN_PASSWORD=Admin@Local2026

# Parse uploads on a background thread (false = inline, used by tests)
ASYNC_PROCESSING=true
